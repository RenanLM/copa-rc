{
  "name": "rc-championship",
  "private": true,
  "version": "0.1.0",
  "description": "RC Championship — aplicativo mobile de acompanhamento de corridas de carros por controle remoto",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
